rules_version = '2';

// Pravila za bazu Majstori Pazova.
// Nalepiti u Firebase konzoli: Firestore -> Rules -> Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Nalog sa potvrđenim emailom (Google nalozi su uvek potvrđeni;
    // kod registracije emailom korisnik mora da klikne link iz mejla)
    function potvrdjen() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // Majstore dodaje i menja samo administrator
    function jeAdmin() {
      return request.auth != null
        && request.auth.token.email == 'milosnpcz97@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Podaci majstora koje upisuje administrator (dodavanje, izmena, sakrivanje)
    function validanMajstor() {
      let d = request.resource.data;
      return d.keys().hasOnly(['ime', 'kategorija', 'mesta', 'iskustvo', 'opis', 'telefon',
                               'aktivan', 'prijava', 'mesto', 'hitno', 'vikendom'])
        && d.keys().hasAll(['ime', 'kategorija', 'mesta', 'aktivan'])
        && d.ime is string && d.ime.size() >= 2 && d.ime.size() <= 60
        && d.kategorija in ['struja', 'voda', 'krecenje', 'keramika', 'stolar',
                            'tesar', 'teski', 'klima', 'bravar', 'krov']
        && d.mesta is list && d.mesta.size() >= 1 && d.mesta.size() <= 10
        && d.aktivan is bool
        && (!('telefon' in d) || (d.telefon is string
             && (d.telefon == '' || d.telefon.matches('^([+]381|0)[0-9]{8,9}$'))))
        && (!('iskustvo' in d) || (d.iskustvo is int && d.iskustvo >= 0 && d.iskustvo <= 60))
        && (!('opis' in d) || (d.opis is string && d.opis.size() <= 500))
        && (!('mesto' in d) || (d.mesto is string && d.mesto.size() <= 40))
        && (!('hitno' in d) || d.hitno is bool)
        && (!('vikendom' in d) || d.vikendom is bool);
    }

    function validnaOcena(mid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['ocena', 'komentar', 'ime', 'oznake', 'uid', 'vreme'])
        && d.keys().hasAll(['ocena', 'komentar', 'ime', 'oznake', 'uid', 'vreme'])
        && d.ocena is int && d.ocena >= 1 && d.ocena <= 5
        && d.komentar is string && d.komentar.size() <= 500
        && d.ime is string && d.ime.size() >= 1 && d.ime.size() <= 30
        && d.ime.matches('^[^ ]+( [^ ][.])?$')
        && d.oznake is list && d.oznake.size() <= 3
        && d.oznake.toSet().hasOnly(['Stigao na vreme', 'Cena kao dogovorena', 'Čisto i uredno'])
        && d.uid == request.auth.uid
        && d.vreme == request.time
        && exists(/databases/$(database)/documents/majstori/$(mid));
    }

    function validnaPrijava() {
      let d = request.resource.data;
      let polja = ['ime', 'telefon', 'kategorija', 'mesta', 'iskustvo', 'opis',
                   'saglasnost', 'status', 'uid', 'email', 'vreme'];
      return d.keys().hasOnly(polja) && d.keys().hasAll(polja)
        && d.ime is string && d.ime.size() >= 3 && d.ime.size() <= 50
        && d.telefon is string && d.telefon.matches('^([+]381|0)[0-9]{8,9}$')
        && d.kategorija in ['struja', 'voda', 'krecenje', 'keramika', 'stolar',
                            'tesar', 'teski', 'klima', 'bravar', 'krov']
        && d.mesta is list && d.mesta.size() >= 1 && d.mesta.size() <= 10
        && d.mesta.toSet().hasOnly(['Stara Pazova', 'Nova Pazova', 'Novi Banovci',
             'Stari Banovci', 'Banovci-Dunav', 'Belegiš', 'Surduk', 'Golubinci',
             'Vojka', 'Krnješevci'])
        && d.iskustvo is int && d.iskustvo >= 0 && d.iskustvo <= 60
        && d.opis is string && d.opis.size() >= 20 && d.opis.size() <= 300
        && d.saglasnost == true
        && d.status == 'na_cekanju'
        && d.uid == request.auth.uid
        && d.email == request.auth.token.email
        && d.vreme == request.time;
    }

    // Prijave majstora: jedna po Google nalogu (ID dokumenta je uid).
    // Vidi ih samo podnosilac i administrator; broj nije javan dok se ne odobri.
    match /prijave/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || jeAdmin());
      allow create: if potvrdjen() && request.auth.uid == uid && validnaPrijava();
      allow update, delete: if jeAdmin();
    }

    // Javno se vide samo aktivni majstori; sakrivene vidi samo administrator
    match /majstori/{mid} {
      allow read: if resource.data.aktivan == true || jeAdmin();
      allow create, update: if jeAdmin() && validanMajstor();
      allow delete: if jeAdmin();

      // Jedna ocena po korisniku po majstoru: ID dokumenta je uid korisnika
      match /ocene/{uid} {
        allow read: if true;
        allow create, update: if potvrdjen()
          && request.auth.uid == uid
          && validnaOcena(mid);
        allow delete: if request.auth != null
          && (request.auth.uid == uid || jeAdmin());

        // Dojava (prijava neprimerenog komentara): jedna po korisniku po recenziji.
        // Vidi ih i briše samo administrator.
        match /dojave/{prijavio} {
          allow create: if potvrdjen()
            && request.auth.uid == prijavio
            && prijavio != uid
            && request.resource.data.keys().hasOnly(['uid', 'vreme'])
            && request.resource.data.uid == prijavio
            && request.resource.data.vreme == request.time
            && exists(/databases/$(database)/documents/majstori/$(mid)/ocene/$(uid));
          allow read, delete: if jeAdmin();
        }
      }
    }

    // Admin čita sve dojave odjednom
    match /{path=**}/dojave/{prijavio} {
      allow read: if jeAdmin();
    }

    // Aplikacija čita sve ocene odjednom (za proseke na listi)
    match /{path=**}/ocene/{uid} {
      allow read: if true;
    }
  }
}
